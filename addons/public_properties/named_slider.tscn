[sub_resource type="GDScript" id="GDScript_j21r5"]
script/source = "@tool
extends BoxContainer


@export_storage var children_properties: Dictionary[NodePath, Variant]


func _get_property_list() -> Array[Dictionary]:        return PublicProperties.node_get_children_property_list(self)
func _get(property: StringName) -> Variant:            return PublicProperties.node_get(self, children_properties, property)
func _set(property: StringName, new: Variant) -> bool: return PublicProperties.node_set(self, children_properties, property, new)
func _notification(what: int) -> void:                        PublicProperties.node_notification(self, children_properties, what)
func _ready() -> void: PublicProperties.node_ready(self, children_properties)
"

[sub_resource type="GDScript" id="GDScript_n8o23"]
script/source = "@tool
extends HSlider


func _init() -> void:
	changed.connect(_on_changed)


func _on_changed() -> void:
	tick_count = 0 if is_zero_approx(step) else abs((max_value - min_value) / step  + 1.0) 
"

